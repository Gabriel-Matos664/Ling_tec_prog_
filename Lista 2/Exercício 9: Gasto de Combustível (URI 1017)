#include <stdio.h>

int main() {
    int tempo, velocidade;
    
    printf("Digite o tempo gasto (em horas): ");
    scanf("%d", &tempo);
    printf("Digite a velocidade media (em km/h): ");
    scanf("%d", &velocidade);
    
    double distancia = tempo * velocidade;
    // Autonomia do veiculo: 12 KM/L
    double litros = distancia / 12.0;
    
    printf("%.3f\n", litros);
    
    return 0;
}
